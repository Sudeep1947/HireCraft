# Optional: leave unset (dev default) to use the same-origin Vite proxy (/api -> :8000).
# If you override it, the client appends /api/v1 — so set the ROOT, not the /api/v1 path.
# The interview video room reuses this same base for its signaling WebSocket
# (ws:// or wss://, at /api/v1/interview/:id/video); unset means same-origin,
# which the Vite dev proxy forwards (see vite.config.ts, `ws: true`).
#VITE_API_BASE_URL=http://localhost:8000

# Optional: ICE servers for the peer-to-peer interview video, as a JSON array of
# RTCIceServer objects. When unset, a public STUN server is used, which is enough
# for most home and office networks. Deployments behind strict/symmetric NATs
# should add a TURN server here.
#VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Optional frontend client ID overrides (if initiating directly on client):
# The frontend automatically fetches the server-configured authorization URL
# from /api/v1/auth/oauth/{provider}/url when these are unset.
#VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
#VITE_MICROSOFT_CLIENT_ID=your-microsoft-app-client-id
