# =============================================================================
# AI Hiring Copilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to source control — it contains secrets.
# =============================================================================

# App
APP_NAME="AI Hiring Copilot"
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development  # development | testing | staging | production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hire
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — GENERATE A REAL KEY FOR PRODUCTION:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins, or JSON array)
# Include every origin that loads the app — e.g. localhost AND the LAN IP/domain
# your team actually opens in the browser (http://192.168.x.x:5173 in dev).
CORS_ORIGINS=["http://localhost:5173","http://<YOUR_LAN_IP>:5173"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Providers (set at least one)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Tuning
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_FALLBACK_ENABLED=true

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AI Hiring Copilot"

# Invitations
INVITATION_EXPIRATION_HOURS=72

# Frontend
# Public origin embedded in invitation/verification/activation emails. This is
# the same origin the recipient's browser loads, so it must be reachable FROM
# THEIR network — not just from yours.
#   Development  http://localhost:5173   (only works for a recipient on this machine)
#   Staging      https://staging.yourdomain.com
#   Production   https://app.yourdomain.com
# Outside development the app refuses to start if this is localhost, 127.0.0.1,
# a private IP (10.x, 172.16-31.x, 192.168.x) or an internal hostname, because
# those emails reach nobody. Set a real public hostname per environment; never
# hardcode an address in code.
FRONTEND_BASE_URL=http://localhost:5173

# =============================================================================
# OAuth 2.0 / OpenID Connect (Google & Microsoft SSO)
# =============================================================================
# Google OAuth Configuration:
# 1. Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
# 2. Add Authorized JavaScript origins:
#    - Development: http://localhost:5173
#    - Production:  https://app.hirecraft.ai
# 3. Add Authorized redirect URIs:
#    - Development: http://localhost:5173/auth/callback/google
#    - Production:  https://app.hirecraft.ai/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to {FRONTEND_BASE_URL}/auth/callback/google):
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# Microsoft Entra ID (Azure AD / Microsoft 365) Configuration:
# 1. Register an App in Microsoft Entra Admin Center / Azure Portal:
#    https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# 2. Set Supported account types (e.g. Multitenant + personal Microsoft accounts)
# 3. Add Web platform redirect URI:
#    - Development: http://localhost:5173/auth/callback/microsoft
#    - Production:  https://app.hirecraft.ai/auth/callback/microsoft
# 4. Under Certificates & secrets, create a Client Secret.
# 5. Under API permissions, grant: openid, profile, email, User.Read (delegated).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Optional override (defaults to {FRONTEND_BASE_URL}/auth/callback/microsoft):
# MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback/microsoft
